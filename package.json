{
  "name": "valaria",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets": "tsx tools/assets/build.ts",
    "content:check": "tsx tools/content/validate.ts",
    "admin": "vite --config admin/vite.config.ts",
    "android:sync": "npm run build && cap sync android"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "peerjs": "^1.5.5",
    "phaser": "^4.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.20",
    "playwright-core": "^1.64.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
